# VM mode (server/node.mjs). Copy to .env and fill in. Never commit .env.
MYUPLINK_CLIENT_ID=
MYUPLINK_CLIENT_SECRET=
# 1 = show the house phase currents (BE1-BE3). Leave empty unless the site sits behind authentication.
SHOW_HOUSE=
PORT=8787
# 127.0.0.1 by default; use 0.0.0.0 only behind an authenticated reverse proxy.
HOST=127.0.0.1
DB_PATH=./data/pac.db
# Minutes between collections; 0 = no collection (read-only / demo).
POLL_MINUTES=5
# Electricity cost board (private area / SHOW_HOUSE=1 only). Price per kWh, base or peak.
PRICE_KWH=0.1952
# Optional off-peak tariff: price and local hours (comma-separated ranges, e.g. 22-6 or 23:30-7:30,12-14).
PRICE_HC=
HC_HOURS=22-6
TIMEZONE=Europe/Paris
