# Mode VM (server/node.mjs). Copier en .env et remplir. Ne jamais committer .env.
MYUPLINK_CLIENT_ID=
MYUPLINK_CLIENT_SECRET=
# 1 = publie les intensités des phases de la maison (BE1-BE3). À laisser vide si le site n'est pas protégé.
SHOW_HOUSE=
PORT=8787
# 127.0.0.1 par défaut ; 0.0.0.0 seulement derrière un reverse proxy authentifié.
HOST=127.0.0.1
DB_PATH=./data/pac.db
