// Copy to wrangler.jsonc, then set your hostname and the D1 ID (from `npx wrangler d1 create pac`).
{
  "name": "pac",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/prive", "/prive/*"] },
  "routes": [{ "pattern": "pac.example.com", "custom_domain": true }],
  // No workers.dev URL: it would bypass Cloudflare Access on your hostname.
  "workers_dev": false,
  // Collect from myUplink every 5 min (API quota: 25 req/min; ~3 requests per run).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "pac", "database_id": "REPLACE-WITH-YOUR-D1-ID", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  // 60 API requests per minute per IP.
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
  // Private area /prive/ (house phase currents): protect https://<host>/prive with a Cloudflare Access app,
  // then set your team name and the app's AUD tag so the Worker verifies the Access token itself.
  // "vars": { "ACCESS_TEAM": "your-team", "ACCESS_AUD": "your-app-aud-tag",
  //           "PRICE_KWH": "0.1952", "PRICE_HC": "0.1635", "HC_HOURS": "22-6", "TIMEZONE": "Europe/Paris", "MONTHLY_FEE": "" }
  // Line-by-line tariff instead (prices excl. VAT), e.g. Luxembourg 2026:
  //   "ENERGY_BANDS": "wd:0-6=0.09213,6-17=0.13213,17-24=0.14213;we:0-6=0.09213,6-12=0.13213,12-17=0.09213,17-24=0.14213",
  //   "TAX_KWH": "0.001", "COMPENSATION_KWH": "-0.0371", "NETWORK_KWH": "0.051", "VAT": "0.08",
  //   "SHARED_ENERGY_KWH": "0.105", "SHARED_VAT": "0", "PREF_KW": "7"
}
