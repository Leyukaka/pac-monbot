// Copy to wrangler.jsonc, then set your hostname and the D1 ID (from `npx wrangler d1 create pac`).
{
  "name": "pac",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "pac.example.com", "custom_domain": true }],
  // No workers.dev URL: it would bypass Cloudflare Access on your hostname.
  "workers_dev": false,
  // Collect from myUplink every 5 min (API quota: 25 req/min; ~3 requests per run).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "pac", "database_id": "REPLACE-WITH-YOUR-D1-ID", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  // 60 API requests per minute per IP.
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
  // "vars": { "SHOW_HOUSE": "1" }  // only once the site is protected (Access)
}
